{
  "name": "pinzone",
  "version": "0.1.0",
  "description": "The IANA timezone at a coordinate, exact at the points you care about, with no file reads at runtime. Built for serverless.",
  "keywords": [
    "timezone",
    "tz",
    "iana",
    "coordinates",
    "geolocation",
    "serverless",
    "lambda",
    "vercel",
    "geo-tz"
  ],
  "license": "MIT",
  "author": "oo-pibe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oo-pibe/pinzone.git"
  },
  "homepage": "https://github.com/oo-pibe/pinzone#readme",
  "bugs": {
    "url": "https://github.com/oo-pibe/pinzone/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/lookup.d.ts",
      "default": "./dist/lookup.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "pinzone": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "llms.txt"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.6.1"
  },
  "peerDependencies": {
    "geo-tz": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "geo-tz": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "esbuild": "^0.28.2",
    "geo-tz": "^8.1.8",
    "typescript": "^7.0.2"
  },
  "sideEffects": false
}
