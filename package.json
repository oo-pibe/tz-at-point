{
  "name": "tz-at-point",
  "version": "0.1.0",
  "description": "Offline timezone lookup for coordinates you know in advance: resolve points to IANA timezones at build time with geo-tz, commit a small table, look them up with no filesystem access.",
  "keywords": [
    "timezone",
    "timezone-lookup",
    "timezone-finder",
    "tz",
    "tzdb",
    "iana-timezone",
    "offline",
    "coordinates",
    "latitude",
    "longitude",
    "lat-lng",
    "geo-tz",
    "geolocation",
    "serverless",
    "lambda",
    "edge-runtime",
    "bundler",
    "build-time"
  ],
  "license": "MIT",
  "author": "oo-pibe",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oo-pibe/tz-at-point.git"
  },
  "homepage": "https://github.com/oo-pibe/tz-at-point#readme",
  "bugs": {
    "url": "https://github.com/oo-pibe/tz-at-point/issues"
  },
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/lookup.d.ts",
      "default": "./dist/lookup.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "tz-at-point": "dist/cli.js"
  },
  "files": [
    "dist",
    "skills",
    "llms.txt"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test test/*.test.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@photostructure/tz-lookup": "^11.6.1"
  },
  "peerDependencies": {
    "geo-tz": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "geo-tz": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.28.2",
    "geo-tz": "8.1.8",
    "typescript": "^7.0.2"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
